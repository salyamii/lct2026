  },
  "cards": [
    {
      "id": "2363:4",
      "name": "G1.01 · Ночь наблюдений",
      "texts": [
        {
          "id": "2363:14",
          "text": "12:00"
        },
        {
          "id": "2363:27",
          "text": "Большая цель"
        },
        {
          "id": "2363:32",
          "text": "Ночь наблюдений"
        },
        {
          "id": "2363:33",
          "text": "Через несколько недель откроется старый небесный зал. Но телескоп пока не готов. Соберём комплект постепенно — это наша большая цель."
        },
        {
          "id": "2363:36",
          "text": "Цель: 180 монет"
        },
        {
          "id": "2363:38",
          "text": "Без траты"
        },
        {
          "id": "2363:41",
          "text": "Начать собирать комплект"
        },
        {
          "id": "2363:43",
          "text": "Вернуться позже"
        },
        {
          "id": "2363:44",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2363-4"
    },
    {
      "id": "2371:2",
      "name": "G1.02 · Странный знак на ящике",
      "texts": [
        {
          "id": "2371:17",
          "text": "12:00"
        },
        {
          "id": "2371:30",
          "text": "Тайна"
        },
        {
          "id": "2371:35",
          "text": "На ящике странная метка"
        },
        {
          "id": "2371:36",
          "text": "Бобёр: «Такие знаки ставили на грузах для северной башни. Только башня давно погасла…»"
        },
        {
          "id": "2371:39",
          "text": "Новая зацепка"
        },
        {
          "id": "2371:41",
          "text": "Без траты"
        },
        {
          "id": "2371:44",
          "text": "Зарисовать знак"
        },
        {
          "id": "2371:46",
          "text": "Вернуться позже"
        },
        {
          "id": "2371:47",
          "text": "Глава 1 · Причал"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2371-2"
    },
    {
      "id": "2383:2",
      "name": "G1.03 · Пластина с тем же знаком",
      "texts": [
        {
          "id": "2383:17",
          "text": "12:00"
        },
        {
          "id": "2383:30",
          "text": "Находка"
        },
        {
          "id": "2383:35",
          "text": "Пластина с тем же знаком"
        },
        {
          "id": "2383:36",
          "text": "Смотритель: «Я не ошибся. Тот же знак». Надпись на пластине почти скрыта налётом — её придётся очистить."
        },
        {
          "id": "2383:39",
          "text": "Новая зацепка"
        },
        {
          "id": "2383:41",
          "text": "Без траты"
        },
        {
          "id": "2383:44",
          "text": "Очистить пластину"
        },
        {
          "id": "2383:46",
          "text": "Вернуться позже"
        },
        {
          "id": "2383:47",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2383-2"
    },
    {
      "id": "2390:2",
      "name": "G1.04 · Запись в журнале грузов",
      "texts": [
        {
          "id": "2390:22",
          "text": "12:00"
        },
        {
          "id": "2390:35",
          "text": "Архив причала"
        },
        {
          "id": "2390:40",
          "text": "Запись в журнале грузов"
        },
        {
          "id": "2390:41",
          "text": "Бобёр находит старую запись: грузы со знаком отправлялись не прямо к башне, а через дорожные посты. Значит, сеть была больше одной башни."
        },
        {
          "id": "2390:44",
          "text": "Старый маршрут"
        },
        {
          "id": "2390:46",
          "text": "Без траты"
        },
        {
          "id": "2390:49",
          "text": "Изучить маршрут"
        },
        {
          "id": "2390:51",
          "text": "Вернуться позже"
        },
        {
          "id": "2390:52",
          "text": "Глава 1 · Причал"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2390-2"
    },
    {
      "id": "2386:2",
      "name": "G1.05 · Три ответа — в одном свете",
      "texts": [
        {
          "id": "2386:22",
          "text": "12:00"
        },
        {
          "id": "2386:35",
          "text": "Расшифровка"
        },
        {
          "id": "2386:40",
          "text": "Три ответа — в одном свете"
        },
        {
          "id": "2386:41",
          "text": "Под налётом проступает фраза: «Когда северная башня погаснет, ищи три ответа в одном свете». Смотритель: «Пока не понимаю. Но это уже точно не случайная метка»."
        },
        {
          "id": "2386:44",
          "text": "Загадка башни"
        },
        {
          "id": "2386:46",
          "text": "Без траты"
        },
        {
          "id": "2386:49",
          "text": "Запомнить подсказку"
        },
        {
          "id": "2386:51",
          "text": "Вернуться позже"
        },
        {
          "id": "2386:52",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2386-2"
    },
    {
      "id": "2397:2",
      "name": "G1.06 · Старая карта",
      "texts": [
        {
          "id": "2397:22",
          "text": "12:00"
        },
        {
          "id": "2397:35",
          "text": "Находка"
        },
        {
          "id": "2397:40",
          "text": "Старая карта"
        },
        {
          "id": "2397:41",
          "text": "На старой карте отмечены мост и башня. Рядом с башней — знакомый знак. Теперь ясно: это реальное место, а не портовая байка."
        },
        {
          "id": "2397:44",
          "text": "Старая дорога"
        },
        {
          "id": "2397:46",
          "text": "Без траты"
        },
        {
          "id": "2397:49",
          "text": "Рассмотреть карту"
        },
        {
          "id": "2397:51",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:52",
          "text": "Глава 1 · Причал"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-2"
    },
    {
      "id": "2397:53",
      "name": "G1.07 · Старая эмблема службы",
      "texts": [
        {
          "id": "2397:73",
          "text": "12:00"
        },
        {
          "id": "2397:86",
          "text": "Находка"
        },
        {
          "id": "2397:91",
          "text": "Старая эмблема службы"
        },
        {
          "id": "2397:92",
          "text": "«Похоже, это был не просто знак груза». На обороте эмблемы выбито: «служба путей». Название пока неполное, но сеть явно была официальной."
        },
        {
          "id": "2397:95",
          "text": "Служба путей"
        },
        {
          "id": "2397:97",
          "text": "Без траты"
        },
        {
          "id": "2397:100",
          "text": "Осмотреть эмблему"
        },
        {
          "id": "2397:102",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:103",
          "text": "Глава 1 · Архив"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-53"
    },
    {
      "id": "2397:104",
      "name": "G1.08 · Схема трёх линз",
      "texts": [
        {
          "id": "2397:124",
          "text": "12:00"
        },
        {
          "id": "2397:137",
          "text": "Находка"
        },
        {
          "id": "2397:142",
          "text": "Схема трёх линз"
        },
        {
          "id": "2397:143",
          "text": "На старом чертеже — три линзы разных цветов. Подпись указывает: порядок задавался на дорожном посту."
        },
        {
          "id": "2397:146",
          "text": "Дорожный пост"
        },
        {
          "id": "2397:148",
          "text": "Без траты"
        },
        {
          "id": "2397:151",
          "text": "Изучить чертёж"
        },
        {
          "id": "2397:153",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:154",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-104"
    },
    {
      "id": "2397:155",
      "name": "G1.09 · Каменный пост",
      "texts": [
        {
          "id": "2397:175",
          "text": "12:00"
        },
        {
          "id": "2397:188",
          "text": "Находка"
        },
        {
          "id": "2397:193",
          "text": "Каменный пост"
        },
        {
          "id": "2397:194",
          "text": "Три линзы совпадают с архивной схемой. Если посмотреть через них по порядку, на куполе обсерватории появляются три отражения."
        },
        {
          "id": "2397:197",
          "text": "Порядок цветов"
        },
        {
          "id": "2397:199",
          "text": "Без траты"
        },
        {
          "id": "2397:202",
          "text": "Записать порядок"
        },
        {
          "id": "2397:204",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:205",
          "text": "Глава 1 · Старая дорога"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-155"
    },
    {
      "id": "2397:206",
      "name": "G1.10 · Малый телескоп и старый журнал",
      "texts": [
        {
          "id": "2397:226",
          "text": "12:00"
        },
        {
          "id": "2397:239",
          "text": "Находка"
        },
        {
          "id": "2397:244",
          "text": "Малый телескоп и старый журнал"
        },
        {
          "id": "2397:245",
          "text": "Во время настройки Рыжик замечает в журнале: «Северный пост отвечает тремя сигнальными огнями». Цвета совпадают с найденным порядком."
        },
        {
          "id": "2397:248",
          "text": "Три сигнала"
        },
        {
          "id": "2397:250",
          "text": "Без траты"
        },
        {
          "id": "2397:253",
          "text": "Настроить телескоп"
        },
        {
          "id": "2397:255",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:256",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-206"
    },
    {
      "id": "2397:257",
      "name": "G1.11 · Башня отвечает",
      "texts": [
        {
          "id": "2397:277",
          "text": "12:00"
        },
        {
          "id": "2397:290",
          "text": "Находка"
        },
        {
          "id": "2397:295",
          "text": "Башня отвечает"
        },
        {
          "id": "2397:296",
          "text": "Башня вспыхивает три раза — ровно в найденном порядке. Смотритель тихо говорит: «Она не погасла. Она отвечает»."
        },
        {
          "id": "2397:299",
          "text": "Башня жива"
        },
        {
          "id": "2397:301",
          "text": "Без траты"
        },
        {
          "id": "2397:304",
          "text": "Запомнить сигнал"
        },
        {
          "id": "2397:306",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:307",
          "text": "Глава 1 · Обсерватория"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-257"
    },
    {
      "id": "2397:308",
      "name": "G1.12 · Ночь наблюдений раскрывает сеть",
      "texts": [
        {
          "id": "2397:328",
          "text": "12:00"
        },
        {
          "id": "2397:341",
          "text": "Открытие"
        },
        {
          "id": "2412:2",
          "text": "Обсерватория"
        },
        {
          "id": "2412:3",
          "text": "Посты"
        },
        {
          "id": "2412:4",
          "text": "Башня"
        },
        {
          "id": "2397:346",
          "text": "Ночь наблюдений раскрывает сеть"
        },
        {
          "id": "2397:347",
          "text": "Во время Ночи наблюдений старые метки складываются в сеть маршрутов. Смотритель: «Это была целая служба — Смотрители путей. А башня была одним из их узлов. Если хотим узнать больше, придётся готовить настоящую экспедицию»."
        },
        {
          "id": "2397:350",
          "text": "Большая цель завершена"
        },
        {
          "id": "2397:352",
          "text": "Без траты"
        },
        {
          "id": "2397:355",
          "text": "Готовиться к экспедиции"
        },
        {
          "id": "2397:357",
          "text": "Вернуться позже"
        },
        {
          "id": "2397:358",
          "text": "Глава 1 · Ночь наблюдений"
        }
      ],
      "sourceUrl": "https://www.figma.com/design/bAod1cKtTX9Q8omQ067q3q/?node-id=2397-308"
    }
  ]
}
