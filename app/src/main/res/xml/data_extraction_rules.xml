<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the database and its journal/WAL files; device transfer also needs a policy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
